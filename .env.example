# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
#
# This is one of four credential sources, in this order:
#   1. `--connection NAME`: a connection in Snowflake's config.toml / connections.toml.
#   2. This file (or the environment), when SNOWFLAKE_ACCOUNT is set.
#   3. Your Snowflake default connection, e.g. [connections.default] in
#      ~/.snowflake/config.toml, the one the Snowflake CLI uses.
#   4. Prompts at runtime for anything still missing.
# If you already have a default connection, you don't need this file at all.

# Required

SNOWFLAKE_ACCOUNT=myorg-myaccount
SNOWFLAKE_USER=me

# One credential is required: a password, or SSO via the authenticator.
SNOWFLAKE_PASSWORD=
# SNOWFLAKE_AUTHENTICATOR=externalbrowser

# Role used for the run and the ACCOUNT_USAGE report (needs ACCOUNT_USAGE access).
SNOWFLAKE_ROLE=ACCOUNTADMIN
